 \u043d\u0430\u0448 \u0441\u043b\u043e\u0432\u0430\u0440\u044c \u0438\u0437 \u0432\u0441\u0435\u0445 \u0441\u043b\u043e\u0432 \ud835\udc49 = \ud835\udc64\ud835\udc56 \ud835\udc56.\n\u041a\u0430\u0436\u0434\u043e\u043c\u0443 \u0441\u043b\u043e\u0432\u0443 \u0441\u043e\u043f\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u043c \u0432\u0435\u043a\u0442\u043e\u0440 0, 1 |\ud835\udc49|, \u0433\u0434\u0435 1 \u0441\u0442\u0430\u0432\u0438\u0442\u0441\u044f \u0442\u043e\u043b\u044c\u043a\u043e \u043d\u0430 \u043f\u043e\u0437\u0438\u0446\u0438\u0438\n\u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044e\u0449\u0435\u0439 \u0438\u043d\u0434\u0435\u043a\u0441\u0443 \u0434\u0430\u043d\u043d\u043e\u0433\u043e \u0441\u043b\u043e\u0432\u0430 \u0432 \u0441\u043b\u043e\u0432\u0430\u0440\u0435.\n\u0422\u0435\u043a\u0441\u0442 \u0440\u0430\u0437\u043c\u0435\u0440\u0430 \ud835\udc3e \u0441\u043b\u043e\u0432 \u0431\u0443\u0434\u0435\u0442 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u044f\u0442\u044c\u0441\u044f \u043c\u0430\u0442\u0440\u0438\u0446\u0435\u0439 0, 1 \ud835\udc3e\u00d7|\ud835\udc49|.\n\u041f\u0440\u043e\u0431\u043b\u0435\u043c\u044b:\n\u2022 \u041e\u0447\u0435\u043d\u044c \u0431\u043e\u043b\u044c\u0448\u043e\u0439 \u0440\u0430\u0437\u043c\u0435\u0440 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u0439.\n\u2022 \u0412\u0441\u0435 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u044f \u0440\u0430\u0437\u043b\u0438\u0447\u043d\u044b\u0445 \u0441\u043b\u043e\u0432 \u043e\u0440\u0442\u043e\u0433\u043e\u043d\u0430\u043b\u044c\u043d\u044b \u0434\u0440\u0443\u0433 -\u0434\u0440\u0443\u0433\u0443, \u043d\u0435\u0442 \u043f\u043e\u043d\u044f\u0442\u0438\u044f\n\u0434\u0438\u0441\u0442\u0430\u043d\u0446\u0438\u0438.\n\u2022 \u041d\u0438\u043a\u0430\u043a\u043e\u0439 \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u0438.\n19.02.2024 \u043b\u0435\u043a\u0446\u0438\u044f 2 (Attention \u0438 Transformer) 5\n1.2.2. \u042d\u043c\u0431\u0435\u0434\u0434\u0438\u043d\u0433\u0438 (Bag Of Words ~ BoW)\n\u0412\u0430\u0440\u0438\u0430\u043d\u0442 \u043f\u043e\u0441\u0442\u0440\u043e\u0435\u043d\u0438\u044f \u044d\u043c\u0431\u0435\u0434\u0434\u0438\u043d\u0433\u043e\u0432 \u0434\u043b\u044f \u0442\u0435\u043a\u0441\u0442\u043e\u0432 \u2013 \u0441\u0443\u043c\u043c\u0430 one-hot \u0432\u0435\u043a\u0442\u043e\u0440\u043e\u0432 \u0441\u043b\u043e\u0432.\n\u041f\u043b\u044e\u0441\u044b:\n\u2022 \u0422\u0435\u043f\u0435\u0440\u044c \u0440\u0430\u0437\u043c\u0435\u0440 \u0432\u0435\u043a\u0442\u043e\u0440\u043d\u043e\u0433\u043e \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u044f \u0442\u0435\u043a\u0441\u0442\u0430 \u201c\u0432\u0441\u0435\u0433\u043e \u043b\u0438\u0448\u044c\u201d \u2115|\ud835\udc49|.\n\u2022 \u041f\u0440\u0435\u0434\u043b\u043e\u0436\u0435\u043d\u0438\u044f \u0441 \u043f\u043e\u0445\u043e\u0436\u0438\u043c \u043d\u0430\u0431\u043e\u0440\u043e\u043c \u0441\u043b\u043e\u0432 \u043f\u043e\u0445\u043e\u0436\u0438.\n\u041c\u0438\u043d\u0443\u0441\u044b:\n\u2022 \u0412\u0441\u0451 \u0435\u0449\u0451 \u0441\u043b\u0438\u0448\u043a\u043e\u043c \u0431\u043e\u043b\u044c\u0448\u0438\u0435 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u044f.\n\u2022 \u041f\u043e\u0445\u043e\u0436\u0438\u0435 \u0441\u043b\u043e\u0432\u0430 \u0438\u043b\u0438 \u043f\u043e\u0445\u043e\u0436\u0438\u0435 \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0435\u043d\u0438\u044f, \u043d\u043e \u0438\u0437 \u0440\u0430\u0437\u043d\u044b\u0445 \u0441\u043b\u043e\u0432 \u2013 \u043e\u0440\u0442\u043e\u0433\u043e\u043d\u0430\u043b\u044c\u043d\u044b.\n\u2022 Sparse \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u044f.\n\u2022 \u0422\u0435\u0440\u044f\u0435\u043c \u0432\u0441\u044e \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u044e \u043e \u043f\u043e\u0440\u044f\u0434\u043a\u0435 \u0441\u043b\u043e\u0432.\n19.02.2024 \u043b\u0435\u043a\u0446\u0438\u044f 2 (Attention \u0438 Transformer) 6\n1.2.3. \u042d\u043c\u0431\u0435\u0434\u0434\u0438\u043d\u0433\u0438 (Word2Vec)\n\u0414\u0430\u0432\u0430\u0439\u0442\u0435 \u0431\u0443\u0434\u0435\u043c \u043e\u0431\u0443\u0447\u0430\u0442\u044c \u044d\u043c\u0431\u0435\u0434\u0434\u0438\u043d\u0433\u0438 \u0434\u043b\u044f \u0441\u043b\u043e\u0432 (\u0438\u043b\u0438 \u0447\u0435\u0433\u043e -\u0442\u043e \u0435\u0449\u0451) \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u043e\u0442\u0434\u0435\u043b\u044c\u043d\u044b\u0445\n\u043d\u0435\u0439\u0440\u043e\u0441\u0435\u0442\u0435\u0439.\n\u0418\u0434\u0435\u044f Word2Vec \u2013 \u0431\u0443\u0434\u0435\u043c \u043e\u0431\u0443\u0447\u0430\u0442\u044c\u0441\u044f \u043f\u0440\u0435\u0434\u0441\u043a\u0430\u0437\u044b\u0432\u0430\u0442\u044c \u0441\u0432\u044f\u0437\u044c \u043c\u0435\u0436\u0434\u0443 \u0441\u043b\u043e\u0432\u043e\u043c \u0438 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u0438\u043c\u0438\n\u0441\u043b\u043e\u0432\u0430\u043c\u0438 \u0432 \u0435\u0433\u043e \u0431\u043b\u0438\u0436\u0430\u0439\u0448\u0435\u043c \u043a\u043e\u043d\u0442\u0435\u043a\u0441\u0442\u0435 (\u0444\u0438\u043a\u0441\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u043e\u0433\u043e \u0440\u0430\u0437\u043c\u0435\u0440\u0430 \u043e\u043a\u043d\u0430).\n1. CBoW (Continuous Bag of Words) \u2013 \u043f\u0440\u0435\u0434\u0441\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u043c \u0441\u043b\u043e\u0432\u043e \u043f\u043e \u043a\u043e\u043d\u0442\u0435\u043a\u0441\u0442\u0443 \u0438\u0437 \u043e\u043a\u043d\u0430\n2. Skip-gram \u2013 \u043f\u0440\u0435\u0434\u0441\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u043c \u043a\u043e\u043d\u0442\u0435\u043a\u0441\u0442 \u043f\u043e \u0441\u043b\u043e\u0432\u0443\n19.02.2024 \u043b\u0435\u043a\u0446\u0438\u044f 2 (Attention \u0438 Transformer) 7\n\n1.2.3. \u042d\u043c\u0431\u0435\u0434\u0434\u0438\u043d\u0433\u0438 (Word2Vec)\n19.02.2024 \u043b\u0435\u043a\u0446\u0438\u044f 2 (Attention \u0438 Transformer) 8\n\n1.2.3. \u042d\u043c\u0431\u0435\u0434\u0434\u0438\u043d\u0433\u0438 (Word2Vec)\n\u041f\u043b\u044e\u0441\u044b:\n\u2022 \u041f\u043e\u0445\u043e\u0436\u0438\u0435 \u043f\u043e \u043a\u043e\u043d\u0442\u0435\u043a\u0441\u0442\u0430\u043c \u0441\u043b\u043e\u0432\u0430 \u043e\u043a\u0430\u0437\u044b\u0432\u0430\u044e\u0442\u0441\u044f \u043f\u043e\u0445\u043e\u0436\u0438 \u0432 \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0435 \u044d\u043c\u0431\u0435\u0434\u0434\u0438\u043d\u0433\u043e\u0432.\n\u2022 \u0421\u043c\u044b\u0441\u043b\u043e\u0432\u044b\u0435 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438 \u043c\u0435\u0436\u0434\u0443 \u0441\u043b\u043e\u0432\u0430\u043c\u0438 \u0441\u043e\u0445\u0440\u0430\u043d\u044f\u044e\u0442\u0441\u044f \u043f\u0440\u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445\n\u043e\u043f\u0435\u0440\u0430\u0446\u0438\u044f\u0445 \u043d\u0430\u0434 \u044d\u043c\u0431\u0435\u0434\u0434\u0438\u043d\u0433\u0430\u043c\u0438:\nf(\u043a\u043e\u0440\u043e\u043b\u044c) \u2212 \ud835\udc53(\u043c\u0443\u0436\u0447\u0438\u043d\u0430) + \ud835\udc53(\u0436\u0435\u043d\u0449\u0438\u043d\u0430) \u2248 \ud835\udc53(\u043a\u043e\u0440\u043e\u043b\u0435\u0432\u0430)\n\u041c\u0438\u043d\u0443\u0441\u044b:\n\u2022 \u041f\u043b\u043e\u0445\u043e \u0441\u043f\u0440\u0430\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u0441\u043e \u0441\u043b\u043e\u0432\u0430\u043c\u0438 \u0432\u043d\u0435 \u0441\u043b\u043e\u0432\u0430\u0440\u044f (\u0441\u043b\u043e\u0432\u0430 \u043d\u0435 \u0431\u044b\u043b\u043e \u0432 \u0441\u043b\u043e\u0432\u0430\u0440\u0435 \u2013 \u043d\u0435\u0442 \u043d\u0438\u043a\u0430\u043a\u043e\u0439\n\u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u0438 \u043e \u043d\u0451\u043c).\n\u2022 \u0414\u043b\u044f \u043e\u0434\u043d\u043e\u043a\u043e\u0440\u0435\u043d\u043d\u044b\u0445 \u0438\u043b\u0438 \u0441\u043e\u0441\u0442\u0430\u0432\u043d\u044b\u0445 \u0441 \u043e\u0431\u0449\u0438\u043c\u0438 \u0447\u0430\u0441\u0442\u044f\u043c\u0438 \u0441\u043b\u043e\u0432 \u044d\u043c\u0431\u0435\u0434\u0434\u0438\u043d\u0433\u0438 \u043e\u0431\u0443\u0447\u0430\u044e\u0442\u0441\u044f\n\u043e\u0442\u0434\u0435\u043b\u044c\u043d\u043e \u0438 \u043d\u0438\u043a\u0430\u043a \u043d\u0435 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0442\u0441\u044f \u043f\u043e\u0434\u043e\u0431\u043d\u043e\u0433\u043e \u0440\u043e\u0434\u0430 \u0441\u0432\u044f\u0437\u044c \u043c\u0435\u0436\u0434\u0443 \u0441\u043b\u043e\u0432\u0430\u043c\u0438.\n19.02.2024 \u043b\u0435\u043a\u0446\u0438\u044f 2 (Attention \u0438 Transformer) 9\n1.2.4. \u042d\u043c\u0431\u0435\u0434\u0434\u0438\u043d\u0433\u0438 (GloVe)\nGloVe (Global Vectors) \u2013 \u043f\u043e\u0434\u0445\u043e\u0434 \u043d\u0430 \u043a\u043e\u043d\u0442\u0435\u043a\u0441\u0442\u0430\u0445, \u043a\u0430\u043a \u0438 Word2Vec, \u043d\u043e \u0442\u0430\u043a \u0436\u0435 \u043f\u044b\u0442\u0430\u0435\u0442\u0441\u044f\n\u0443\u0447\u0438\u0442\u044b\u0432\u0430\u0442\u044c \u0433\u043b\u043e\u0431\u0430\u043b\u044c\u043d\u044b\u0435 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438.\n\u041f\u0443\u0441\u0442\u044c \ud835\udc4b\ud835\udf16\u211d|\ud835\udc49|\u00d7|\ud835\udc49| - \u043c\u0430\u0442\u0440\u0438\u0446\u0430 \u0447\u0430\u0441\u0442\u043e\u0442, \u0433\u0434\u0435 \ud835\udc4b\ud835\udc56;\ud835\udc57 - \u043a\u0430\u043a \u0447\u0430\u0441\u0442\u043e \u0441\u043b\u043e\u0432\u043e \ud835\udc57 \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u043b\u043e\u0441\u044c \u0432\n\u043a\u043e\u043d\u0442\u0435\u043a\u0441\u0442\u0435 \u0441\u043b\u043e\u0432\u0430 \ud835\udc56. \u0411\u0443\u0434\u0435\u043c \u0442\u0430\u043a \u0436\u0435 \u043e\u0431\u043e\u0437\u043d\u0430\u0447\u0430\u0442\u044c \ud835\udc4b\ud835\udc56 = \u03c3\ud835\udc58 \ud835\udc4b\ud835\udc56;\ud835\udc58 \u0438 \ud835\udc43\ud835\udc56;\ud835\udc57 = \ud835\udc43 \ud835\udc57 \ud835\udc56 =\n\ud835\udc4b\ud835\udc56;\ud835\udc57\n\ud835\udc4b\ud835\udc56\n."
  },
  {
    "role": "assistant",
    "content": "* __\u0422\u0435\u043a\u0441\u0442__ \u2014 \u044d\u0442\u043e \u043f\u043e\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u0441\u043b\u043e\u0432, \u043c\u0435\u0436\u0434\u0443 \u043a\u043e\u0442\u043e\u0440\u044b\u043c\u0438 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442 \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e \u0441\u0432\u044f\u0437\u0435\u0439: **\u0441\u043c\u044b\u0441\u043b\u043e\u0432\u0430\u044f** (\u0441\u0435\u043c\u0430\u043d\u0442\u0438\u043a\u0430), **\u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u043d\u0430\u044f** (\u0433\u0440\u0430\u043c\u043c\u0430\u0442\u0438\u043a\u0430 \u0438 \u0441\u0438\u043d\u0442\u0430\u043a\u0441\u0438\u0441), **\u043a\u043e\u043d\u0442\u0435\u043a\u0441\u0442\u0443\u0430\u043b\u044c\u043d\u0430\u044f** (\u043b\u043e\u043a\u0430\u043b\u044c\u043d\u044b\u0439 \u0438 \u0433\u043b\u043e\u0431\u0430\u043b\u044c\u043d\u044b\u0439 \u043a\u043e\u043d\u0442\u0435\u043a\u0441\u0442), **\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0430\u044f** (\u043f\u043e\u0440\u044f\u0434\u043e\u043a \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0435\u043d\u0438\u0439 \u0438 \u0434\u0440\u0443\u0433\u0438\u0445 \u0435\u0434\u0438\u043d\u0438\u0446).\n\n* __Word embedding__ \u2014 \u0444\u0443\u043d\u043a\u0446\u0438\u044f \u0434\u043b\u044f \u0432\u0435\u043a\u0442\u043e\u0440\u0438\u0437\u0430\u0446\u0438\u0438 \u0441\u043b\u043e\u0432 **f: V \u2192 \u211d\u1d48**,\n\u043a\u043e\u0442\u043e\u0440\u0430\u044f \u043a\u0430\u0436\u0434\u043e\u043c\u0443 \u0441\u043b\u043e\u0432\u0443 \u0438\u0437 \u0441\u043b\u043e\u0432\u0430\u0440\u044f **V** \u0441\u043e\u043f\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442 \u0432\u0435\u043a\u0442\u043e\u0440 \u0438\u0437 **\u211d\u1d48**.\n\n\u0422\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044f:\n- `f(t\u2081) \u2260 f(t\u2082)`, \u0435\u0441\u043b\u0438 `t\u2081 \u2260 t\u2082`,\n- `f(t\u2081) \u2248 f(t\u2082)`, \u0435\u0441\u043b\u0438 `t\u2081` \u0438 `t\u2082` \u043f\u043e\u0445\u043e\u0436\u0438 \u043f\u043e \u0441\u043c\u044b\u0441\u043b\u0443,\n- `f(t\u2081) \u2249 f(t\u2082)`, \u0435\u0441\u043b\u0438 `t\u2081` \u0438 `t\u2082` \u043d\u0435 \u043f\u043e\u0445\u043e\u0436\u0438 \u043f\u043e \u0441\u043c\u044b\u0441\u043b\u0443.\n\n* __Text embedding__ \u2014 \u0444\u0443\u043d\u043a\u0446\u0438\u044f  **f: V\u207f \u2192 \u211d\u1d48**, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0441\u043e\u043f\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442 \u0446\u0435\u043b\u043e\u043c\u0443 \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0435\u043d\u0438\u044e/\u0442\u0435\u043a\u0441\u0442\u0443 \u0432\u0435\u043a\u0442\u043e\u0440 \u043f\u0440\u0438\u0437\u043d\u0430\u043a\u043e\u0432.\n\n* __One-hot embedding__ \u2014 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u0441\u043b\u043e\u0432\u0430 \u043a\u0430\u043a \u0432\u0435\u043a\u0442\u043e\u0440\u0430 \u0434\u043b\u0438\u043d\u044b `|V|` \u0441 \u043e\u0434\u043d\u043e\u0439 \u0435\u0434\u0438\u043d\u0438\u0446\u0435\u0439 \u0438 \u043e\u0441\u0442\u0430\u043b\u044c\u043d\u044b\u043c\u0438 \u043d\u0443\u043b\u044f\u043c\u0438.\n\n\u041f\u0440\u043e\u0431\u043b\u0435\u043c\u044b:\n- \u0431\u043e\u043b\u044c\u0448\u043e\u0439 \u0440\u0430\u0437\u043c\u0435\u0440 \u0432\u0435\u043a\u0442\u043e\u0440\u0430,\n- \u0432\u0441\u0435 \u0441\u043b\u043e\u0432\u0430 \u043e\u0440\u0442\u043e\u0433\u043e\u043d\u0430\u043b\u044c\u043d\u044b,\n- \u043d\u0435\u0442 \u0440\u0430\u0441\u0441\u0442\u043e\u044f\u043d\u0438\u0439 \u043c\u0435\u0436\u0434\u0443 \u0441\u043b\u043e\u0432\u0430\u043c\u0438,\n- \u043d\u0435\u0442 \u043e\u0431\u043e\u0431\u0449\u0430\u044e\u0449\u0435\u0439 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u0438.\n\n* __BoW__ (__Bag of words__) \u2014  \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u0442\u0435\u043a\u0441\u0442\u0430 \u043a\u0430\u043a \u0441\u0443\u043c\u043c\u044b one-hot \u0432\u0435\u043a\u0442\u043e\u0440\u043e\u0432 \u0432\u0441\u0435\u0445 \u0441\u043b\u043e\u0432.\n\u041f\u043b\u044e\u0441\u044b:\n- \u043a\u043e\u043c\u043f\u0430\u043a\u0442\u043d\u0435\u0435 one-hot,\n- \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0435\u043d\u0438\u044f \u0441 \u043f\u043e\u0445\u043e\u0436\u0438\u043c \u043d\u0430\u0431\u043e\u0440\u043e\u043c \u0441\u043b\u043e\u0432 \u0431\u043b\u0438\u0437\u043a\u0438.\n\n\u041c\u0438\u043d\u0443\u0441\u044b:\n- \u0432\u044b\u0441\u043e\u043a\u0430\u044f \u0440\u0430\u0437\u043c\u0435\u0440\u043d\u043e\u0441\u0442\u044c,\n- \u0442\u0435\u0440\u044f\u0435\u0442\u0441\u044f \u043f\u043e\u0440\u044f\u0434\u043e\u043a \u0441\u043b\u043e\u0432,\n- \u0438\u0433\u043d\u043e\u0440\u0438\u0440\u0443\u044e\u0442\u0441\u044f \u0441\u0435\u043c\u0430\u043d\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0441\u0432\u044f\u0437\u0438.\n\n* __Word2Vec__ \u2014 \u043e\u0431\u0443\u0447\u0430\u0435\u043c\u0430\u044f \u043c\u043e\u0434\u0435\u043b\u044c \u044d\u043c\u0431\u0435\u0434\u0434\u0438\u043d\u0433\u043e\u0432 \u0441\u043b\u043e\u0432 \u043d\u0430 \u043e\u0441\u043d\u043e\u0432\u0435 \u043a\u043e\u043d\u0442\u0435\u043a\u0441\u0442\u0430.\n\n\u0414\u0432\u0430 \u043e\u0441\u043d\u043e\u0432\u043d\u044b\u0445 \u0432\u0430\u0440\u0438\u0430\u043d\u0442\u0430:\n- **CBoW (Continuous Bag of Words)** \u2014 \u043f\u0440\u0435\u0434\u0441\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442 \u0441\u043b\u043e\u0432\u043e \u043f\u043e \u043a\u043e\u043d\u0442\u0435\u043a\u0441\u0442\u0443.\n- **Skip-gram** \u2014 \u043f\u0440\u0435\u0434\u0441\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442 \u043a\u043e\u043d\u0442\u0435\u043a\u0441\u0442 \u043f\u043e \u0441\u043b\u043e\u0432\u0443.\n\n\u041f\u043b\u044e\u0441\u044b:\n- \u043a\u043e\u043d\u0442\u0435\u043a\u0441\u0442\u043d\u043e-\u043f\u043e\u0445\u043e\u0436\u0438\u0435 \u0441\u043b\u043e\u0432\u0430 \u0438\u043c\u0435\u044e\u0442 \u0441\u0445\u043e\u0436\u0438\u0435 \u0432\u0435\u043a\u0442\u043e\u0440\u0430\n- \u0441\u043e\u0445\u0440\u0430\u043d\u044f\u044e\u0442\u0441\u044f \u0441\u043c\u044b\u0441\u043b\u043e\u0432\u044b\u0435 \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f, \u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440:\n`f(\u043a\u043e\u0440\u043e\u043b\u044c) - f(\u043c\u0443\u0436\u0447\u0438\u043d\u0430) + f(\u0436\u0435\u043d\u0449\u0438\u043d\u0430) \u2248 f(\u043a\u043e\u0440\u043e\u043b\u0435\u0432\u0430)`\n\n\u041c\u0438\u043d\u0443\u0441\u044b:\n- \u043d\u0435 \u0440\u0430\u0431\u043e\u0442\u0430\u0435\u0442 \u0441\u043e \u0441\u043b\u043e\u0432\u0430\u043c\u0438 \u0432\u043d\u0435 \u0441\u043b\u043e\u0432\u0430\u0440\u044f,\n- \u043d\u0435 \u0443\u0447\u0438\u0442\u044b\u0432\u0430\u0435\u0442 \u043c\u043e\u0440\u0444\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0438\u043b\u0438 \u0441\u043e\u0441\u0442\u0430\u0432\u043d\u044b\u0435 \u0441\u0432\u044f\u0437\u0438.\n\n* __GloVe__ \u2014 \u043c\u043e\u0434\u0435\u043b\u044c, \u043e\u0431\u044a\u0435\u0434\u0438\u043d\u044f\u044e\u0449\u0430\u044f \u043b\u043e\u043a\u0430\u043b\u044c\u043d\u044b\u0439 \u043a\u043e\u043d\u0442\u0435\u043a\u0441\u0442 \u0438 \u0433\u043b\u043e\u0431\u0430\u043b\u044c\u043d\u044b\u0435 \u0447\u0430\u0441\u0442\u043e\u0442\u044b.\n\n\u041f\u043e\u0441\u0442\u0440\u043e\u0435\u043d\u0438\u0435:\n- **X \u2208 \u211d^{|V| \u00d7 |V|}** \u2014 \u043c\u0430\u0442\u0440\u0438\u0446\u0430 \u0441\u043e\u0432\u043c\u0435\u0441\u0442\u043d\u044b\u0445 \u0447\u0430\u0441\u0442\u043e\u0442:\n`X\u1d62\u2c7c` \u2014 \u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0440\u0430\u0437 \u0441\u043b\u043e\u0432\u043e `j` \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u043b\u043e\u0441\u044c \u0432 \u043a\u043e\u043d\u0442\u0435\u043a\u0441\u0442\u0435 \u0441\u043b\u043e\u0432\u0430 `i`.\n- **X\u1d62 = \u2211\u2096 X\u1d62\u2096** \u2014 \u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0432\u0441\u0435\u0433\u043e \u0441\u043b\u043e\u0432 \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u0435\u0442\u0441\u044f \u0432 \u043a\u043e\u043d\u0442\u0435\u043a\u0441\u0442\u0430\u0445 \u0441\u043b\u043e\u0432\u0430 `i`.\n- **P\u2c7c|\u1d62 = X\u1d62\u2c7c / X\u1d62** \u2014 \u0443\u0441\u043b\u043e\u0432\u043d\u0430\u044f \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u044c \u0441\u043b\u043e\u0432\u0430 `j` \u043f\u0440\u0438 \u0443\u0441\u043b\u043e\u0432\u0438\u0438 `i`."
  }
]